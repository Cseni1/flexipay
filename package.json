{
  "name": "flexipay",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace @flexipay/web",
    "build": "npm run build --workspace @flexipay/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "git config core.hooksPath .husky || true",
    "postinstall": "patch-package",
    "validate:config": "npm run validate:config --workspace @flexipay/domain",
    "test:domain": "npm test --workspace @flexipay/domain",
    "test:live:payout": "npm exec --workspace @flexipay/ui-e2e -- playwright test --config=../e2e-live/playwright.config.ts ../e2e-live/tests/live-payout.spec.ts",
    "demo:offline": "node scripts/demo/offline.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/e2e-ui"
  ],
  "dependencies": {
    "@stellar/stellar-sdk": "^16.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3"
  },
  "prettier": "@theahaco/ts-config/prettier",
  "packageManager": "npm@11.12.1"
}
