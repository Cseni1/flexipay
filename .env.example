# FlexiPay environment variables: names only, no values.
# Public ids: generated into scripts/testnet/testnet-ids.env by scripts/testnet/setup.sh.
# Secrets: generated into scripts/testnet/.env.secrets (git-ignored). On hosting, only in the host's secret store.
# Testnet only. Never commit real values.

# Stellar network (public)
FP_STELLAR_NETWORK=
FP_STELLAR_RPC_URL=
FP_STELLAR_NETWORK_PASSPHRASE=

# Test USDC and payout vault (public) — baseline / non-anchor
FP_USDC_ASSET=
FP_USDC_CONTRACT_ID=
FP_PAYOUT_VAULT_ID=
FP_VAULT_FEE_BPS=
FP_TREASURY_ADDRESS=
# Max total Soroban tx fee (inclusion + resource, once) in stroops. Required for vault writes.
# Default TBD — Claude must confirm; adapter never invents/caps/truncates.
FP_SOROBAN_TX_FEE_CEILING_STROOPS=

# SDF reference anchor + isolated anchor vault (M1 / CCR-20 accepted names). Public ids in
# scripts/testnet/testnet-ids-anchor-vault.env. Does not replace baseline FP_PAYOUT_VAULT_ID.
FP_ANCHOR_HOME_DOMAIN=
FP_ANCHOR_USDC_ASSET=
FP_ANCHOR_USDC_CONTRACT_ID=
FP_ANCHOR_VAULT_ID=
FP_ANCHOR_VAULT_FEE_BPS=
FP_ANCHOR_VAULT_TREASURY_ADDRESS=
FP_ANCHOR_VAULT_PURPOSE=
# When set to 1, createApiRuntime uses createAnchorSettlement (FP_ANCHOR_VAULT_* mapping);
# settlementSimulated=false. Leave empty for baseline settlement.
FP_ANCHOR_MODE=

# Demo accounts (public)
FP_PAYER_DEMO_ADDRESS=
FP_RECIPIENT_A_ADDRESS=
FP_RECIPIENT_B_ADDRESS=

# Secrets (API host only, never in web code)
FP_DEPLOYER_SECRET=
FP_PAYER_DEMO_SECRET=
FP_RECIPIENT_A_SECRET=
FP_RECIPIENT_B_SECRET=

# Settlement adapter selection (ARCHITECTURE §1a / §11.2). Default mock.
# mock → @flexipay/adapters-sim; stellar → @flexipay/adapter-stellar (Csaba wires apps/api).
FP_SETTLEMENT=

# API (apps/api)
DATABASE_URL=
PORT=
FP_CONFIG_DIR=
# Public API base URL for web / demo clients (names only here; values in local env)
FP_API_URL=
# Sandbox API key for the Demo Platform org (Bearer). Never commit real values. No HTTP bootstrap route yet — provision locally (see docs/LOCAL_DEMO.md).
FP_API_KEY=
# Offline launcher ports (scripts/demo/offline.ts); defaults 8788 / 5173
FP_API_PORT=
FP_WEB_PORT=
# 32-byte AES-256-GCM key as 64 hex chars; seals claim secrets at rest (CCR-11). Demo-grade only.
FP_CLAIM_SEAL_KEY=

# CCR-29 partner adapters (sandbox). Leave empty to keep a partner out of routing.
BLINDPAY_API_KEY=
BLINDPAY_INSTANCE_ID=
BLINDPAY_SANDBOX_CUSTOMER_ID=
BLINDPAY_SANDBOX_BANK_ACCOUNT_ID=
BLINDPAY_SANDBOX_WALLET_ID=
# Real money only with the owner's written approval:
FP_BLINDPAY_LIVE_APPROVED=
# Svix signing secret for POST /v1/webhooks/blindpay (whsec_...). Unsigned bodies are rejected.
BLINDPAY_WEBHOOK_SECRET=
# Tazapay HMAC secret for POST /v1/webhooks/tazapay; verifies the raw body, event id and created_at.
TAZAPAY_WEBHOOK_SECRET=
# CCR-49: Jupiter swap (tGBP -> USDC in the sender's wallet, mainnet only). Optional key; without it
# the free lite-api.jup.ag endpoint is used. FP_JUPITER_SWAP=0 turns the swap off.
JUPITER_API_KEY=
FP_JUPITER_SWAP=
TAZAPAY_API_KEY=
TAZAPAY_API_SECRET=
TAZAPAY_SANDBOX_BENEFICIARY_ID=
TAZAPAY_HOLDING_CURRENCY=
TAZAPAY_PURPOSE_CODE=
TAZAPAY_BASE_URL=
# Alert when the available holding balance falls below this many hundredths (default 50000 = 500.00).
TAZAPAY_LOW_BALANCE_ALERT=
FP_TAZAPAY_LIVE_APPROVED=
# CCR-50 Due (due.network) off-ramp. Sandbox keys register due_sandbox against
# api.sandbox.due.network; production keys (DUE_API_KEY + DUE_ACCOUNT_ID) win and point at
# api.due.network, refused unless FP_DUE_LIVE_APPROVED=1 (owner's written approval only).
DUE_SANDBOX_API_KEY=
DUE_SANDBOX_ACCOUNT_ID=
DUE_API_KEY=
DUE_ACCOUNT_ID=
DUE_BASE_URL=
# Due wallet id registered as the USDC sender (funding is matched to it); optional.
DUE_SENDER_WALLET=
# USDC source rail; defaults to solana-local (sandbox) or solana (production).
DUE_SOLANA_RAIL=
# Purpose code when a channel requires one (default OTHER when offered).
DUE_PURPOSE_CODE=
FP_DUE_LIVE_APPROVED=
FP_OPERATOR_ORG_IDS=
VITE_PRIVY_APP_ID=
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# CCR-44 live money. mainnet-beta refuses to start unless FP_LIVE_MONEY=1.
# Devnet is unchanged and does not use these. Never set them in tests.
FP_SOLANA_CLUSTER=
FP_SOLANA_RPC_URL=
FP_SOLANA_USDC_MINT=
FP_LIVE_MONEY=
# 0 pauses POST /v1/quotes and POST /v1/payments in live mode (503 live_payments_paused).
FP_LIVE_PAYMENTS_ENABLED=
# Individual senders only, USD with at most 2 decimal places. Required together in live mode.
FP_INDIVIDUAL_MAX_PAYMENT_USD=
FP_INDIVIDUAL_MAX_24H_USD=
FP_INDIVIDUAL_MAX_30D_USD=
