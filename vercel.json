{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace @flexipay/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://flexipay-api.onrender.com/api/auth/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://flexipay-api.onrender.com/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
