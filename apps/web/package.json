    "concurrently": "^10.0.3",
    "dotenv": "^18.0.9",
    "eslint": "^10.0.0",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix --no-warn-ignored",
