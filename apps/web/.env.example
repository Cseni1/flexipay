# Copy to apps/web/.env for the local web app. Public values only; names start with PUBLIC_.
# The API key is a local demo setting, not a privileged secret. Never put a real secret here.

# Empty means same-origin, which is what the Playwright fixtures use.
PUBLIC_API_URL=http://localhost:8788
# Leave empty until the API issues a demo key; a missing key surfaces as a 401.
PUBLIC_API_KEY=

PUBLIC_STELLAR_NETWORK=TESTNET
PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
