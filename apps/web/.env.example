# Copy to apps/web/.env for the local web app. The Vite dev server reads this file; the
# browser bundle never does. Only PUBLIC_* values are exposed to browser code.
#
# Upstream API origin used by the same-origin dev proxy. Not part of the browser bundle.
FP_API_URL=http://127.0.0.1:8788
# Server-only sandbox key. The proxy adds it as Authorization: Bearer on protected routes.
# Never prefix this with PUBLIC_, put it in Vite define/envPrefix, or commit a value.
FP_API_KEY=

PUBLIC_STELLAR_NETWORK=TESTNET
PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Public Transak staging API key for the Pay-from "Add funds" widget (USDC on Solana).
# Safe to expose in the browser bundle. Never put a production Transak key here.
VITE_TRANSAK_STAGING_KEY=
