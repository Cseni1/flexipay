# Copy to apps/web/.env for the local web app. Public values only.
# FP_API_URL is the existing approved API base URL name from scripts/demo. It is the only
# FP_ variable Vite exposes to the browser; never put an FP_ API key or secret here.
# Empty means same-origin, which is what the Playwright fixtures use.
FP_API_URL=http://localhost:8788

PUBLIC_STELLAR_NETWORK=TESTNET
PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
