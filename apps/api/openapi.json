{
  "openapi": "3.1.0",
  "info": {
    "title": "FlexiPay API",
    "version": "1.0.0",
    "description": "Testnet build. Simulated providers are labelled; no real money moves."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness check",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/corridors": {
      "get": {
        "summary": "Corridors, allowed endpoint types, limits and notes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "corridors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "from": {
                            "type": "object",
                            "properties": {
                              "country": {
                                "type": "string",
                                "pattern": "^[A-Z]{2}$"
                              },
                              "currency": {
                                "type": "string",
                                "pattern": "^[A-Z][A-Z0-9]{2,11}$"
                              }
                            },
                            "required": [
                              "country",
                              "currency"
                            ],
                            "additionalProperties": false
                          },
                          "to": {
                            "type": "object",
                            "properties": {
                              "country": {
                                "type": "string",
                                "pattern": "^[A-Z]{2}$"
                              },
                              "currency": {
                                "type": "string",
                                "pattern": "^[A-Z][A-Z0-9]{2,11}$"
                              }
                            },
                            "required": [
                              "country",
                              "currency"
                            ],
                            "additionalProperties": false
                          },
                          "allowedDestinationTypes": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "bank_account",
                                "ewallet",
                                "crypto_wallet",
                                "crypto_custodial"
                              ]
                            }
                          },
                          "recipientKinds": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "individual",
                                "company"
                              ]
                            }
                          },
                          "cryptoLegAllowed": {
                            "type": "object",
                            "properties": {
                              "individual": {
                                "type": "boolean"
                              },
                              "company": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "individual",
                              "company"
                            ],
                            "additionalProperties": false
                          },
                          "limits": {
                            "type": "object",
                            "properties": {
                              "individual": {
                                "type": "object",
                                "properties": {
                                  "min": {
                                    "type": "object",
                                    "properties": {
                                      "amount": {
                                        "type": "string",
                                        "pattern": "^(0|[1-9][0-9]*)$"
                                      },
                                      "currency": {
                                        "type": "string",
                                        "pattern": "^[A-Z][A-Z0-9]{2,11}$"
                                      }
                                    },
                                    "required": [
                                      "amount",
                                      "currency"
                                    ],
                                    "additionalProperties": false
                                  },
                                  "max": {
                                    "type": "object",
                                    "properties": {
                                      "amount": {
                                        "type": "string",
                                        "pattern": "^(0|[1-9][0-9]*)$"
                                      },
                                      "currency": {
                                        "type": "string",
                                        "pattern": "^[A-Z][A-Z0-9]{2,11}$"
                                      }
                                    },
                                    "required": [
                                      "amount",
                                      "currency"
                                    ],
                                    "additionalProperties": false
                                  }
                                },
                                "required": [
                                  "min",
                                  "max"
                                ],
                                "additionalProperties": false
                              },
                              "company": {
                                "type": "object",
                                "properties": {
                                  "min": {
                                    "type": "object",
                                    "properties": {
                                      "amount": {
                                        "type": "string",
                                        "pattern": "^(0|[1-9][0-9]*)$"
                                      },
                                      "currency": {
                                        "type": "string",
                                        "pattern": "^[A-Z][A-Z0-9]{2,11}$"
                                      }
                                    },
                                    "required": [
                                      "amount",
                                      "currency"
                                    ],
                                    "additionalProperties": false
                                  },
                                  "max": {
                                    "type": "object",
                                    "properties": {
                                      "amount": {
                                        "type": "string",
                                        "pattern": "^(0|[1-9][0-9]*)$"
                                      },
                                      "currency": {
                                        "type": "string",
                                        "pattern": "^[A-Z][A-Z0-9]{2,11}$"
                                      }
                                    },
                                    "required": [
                                      "amount",
                                      "currency"
                                    ],
                                    "additionalProperties": false
                                  }
                                },
                                "required": [
                                  "min",
                                  "max"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "individual",
                              "company"
                            ],
                            "additionalProperties": false
                          },
                          "legsAvailable": {
                            "type": "object",
                            "properties": {
                              "collect": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "pattern": "^[a-z][a-z0-9_]*$"
                                }
                              },
                              "convert": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "pattern": "^[a-z][a-z0-9_]*$"
                                }
                              },
                              "settle": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "pattern": "^[a-z][a-z0-9_]*$"
                                }
                              },
                              "payout": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "pattern": "^[a-z][a-z0-9_]*$"
                                }
                              }
                            },
                            "required": [
                              "collect",
                              "convert",
                              "settle",
                              "payout"
                            ],
                            "additionalProperties": false
                          },
                          "domesticRail": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_]*$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "regulationNote": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          },
                          "simulated": {
                            "type": "boolean"
                          },
                          "placeholder": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "from",
                          "to",
                          "allowedDestinationTypes",
                          "recipientKinds",
                          "cryptoLegAllowed",
                          "limits",
                          "legsAvailable",
                          "domesticRail",
                          "regulationNote",
                          "simulated",
                          "placeholder"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "corridors"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/recipients": {
      "post": {
        "summary": "Create a recipient",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "individual",
                      "company"
                    ]
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  }
                },
                "required": [
                  "name",
                  "kind",
                  "country"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "individual",
                        "company"
                      ]
                    },
                    "country": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "kind",
                    "country",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Idempotency or state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List recipients",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "recipients": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "individual",
                              "company"
                            ]
                          },
                          "country": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "kind",
                          "country",
                          "createdAt"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "recipients"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "details": {}
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
