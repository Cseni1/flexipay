// FlexiPay database schema (ARCHITECTURE §6, §7, §9). Money is stored as integer minor units in
// text columns with a currency column next to them: no floats, no precision loss. Enum-like
// text columns are validated by the zod schemas in packages/domain, not by the database, so
// adding a value never needs a migration. Secrets are stored only as hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id           String   @id
  name         String
  kind         String // business | individual
  verification String   @default("not_started") // not_started | simulated_verified
  createdAt    DateTime @default(now())

  apiKeys       ApiKey[]
  recipients    Recipient[]
  endpoints     Endpoint[]
  quotes        Quote[]
  payments      Payment[]
  batches       Batch[]
  webhooks      WebhookSubscription[]
  events        Event[]
  idempotency   IdempotencyRecord[]
  memberships   Membership[]
}

model ApiKey {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// First characters of the key, to recognise it in the dashboard. Not secret.
  prefix         String
  /// sha256 of the full key; the key itself is shown once and never stored.
  keyHash        String       @unique
  label          String?
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@index([organizationId])
}

model Recipient {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  kind           String // individual | company
  country        String
  createdAt      DateTime     @default(now())

  endpoints Endpoint[]
  payments  Payment[]

  @@index([organizationId])
}

model Endpoint {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  recipientId    String?
  recipient      Recipient?   @relation(fields: [recipientId], references: [id])
  payments       Payment[]
  type           String // bank_account | ewallet | crypto_wallet | crypto_custodial
  country        String? // empty for crypto endpoints
  currency       String
  network        String? // stellar, only for crypto endpoints
  /// Account number, wallet id or address. Masked whenever it is returned or logged.
  details        Json
  /// Partner ids for this endpoint (CCR-32/CCR-34), e.g. { tazapay_beneficiary_id: "bnf_...", blindpay_bank_account_id: "ba_..." }.
  partnerRefs    Json?
  simulated      Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([recipientId])
}

model Quote {
  id               String       @id
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  source           Json // endpoint type, currency, country
  destination      Json // endpoint type, currency, country, recipient kind
  amountSide       String // send | receive
  amountValue      String
  amountCurrency   String
  /// Planned legs, fees, alternatives and reasons, as returned to the client (zod-validated).
  route            Json
  fees             Json
  fxRate           String?
  expectedReceive  String
  receiveCurrency  String
  priceRiskBearer  String
  policy           String       @default("cheapest")
  validUntil       DateTime
  alternatives     Json
  reasons          Json
  /// Vault FeeMode used to price settle (CCR-8 / CCR-13). Null when the route has no settle.
  feeMode          String?
  simulated        Boolean      @default(true)
  createdAt        DateTime     @default(now())

  payments Payment[]

  @@index([organizationId])
}

model Payment {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  quoteId        String
  quote          Quote        @relation(fields: [quoteId], references: [id])
  recipientId    String
  recipient      Recipient    @relation(fields: [recipientId], references: [id])
  /// Destination endpoint chosen at create (batch rows); the payout adapter needs its details.
  endpointId     String?
  endpoint       Endpoint?    @relation(fields: [endpointId], references: [id])
  /// The client's own id; unique per organization. It never goes on-chain (RULES.md).
  externalId     String?
  delivery       String // direct | claim_link
  profile        String // small | batch | invoice | tips | domestic | one_off
  reference      String?
  status         String // quoted | awaiting_funding | funded | processing | paid | ...
  batchId        String?
  batch          Batch?       @relation(fields: [batchId], references: [id])
  /// Current vault lock attempt, from 1. The on-chain id is sha256("<id>:<attempt>").
  lockAttempt    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  legs             Leg[]
  events           Event[]
  claimLink        ClaimLink?
  passkeyPrepares  PasskeyClaimPrepare[]
  audit            AuditRow[]

  @@unique([organizationId, externalId])
  @@index([organizationId, status])
  @@index([batchId])
  @@index([endpointId])
}

model Leg {
  id          String   @id
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])
  /// Position in the route; legs run strictly in this order.
  position    Int
  kind        String // collect | convert | settle | payout
  rail        String // id from providers.json, e.g. sim_bank_us_ach, stellar_usdc
  providerId  String
  amountInValue   String
  amountInCurrency String
  amountOutValue  String
  amountOutCurrency String
  status      String   @default("pending") // pending | processing | succeeded | failed | reversing | reversed
  /// Attempts on the current provider (a retry increments it); a re-route resets it (CCR-14).
  attempt     Int      @default(1)
  /// Provider reference, or for settle legs the vault payoutId only — never a tx hash (CCR-12).
  externalRef String?
  /// Settle lock transaction hash (CCR-12). Null for non-settle / before lock.
  lockTxRef   String?
  /// Settle release or refund transaction hash (CCR-12).
  releaseTxRef String?
  /// CCR-23: confirmed vault deposit tx hash (settle only). Null until deposit confirmed.
  fundTxRef String?
  /// CCR-23: op index of the decoded matching deposit invoke (never assumed 0).
  fundOpIndex Int?
  /// CCR-23: exact deposited minor units (integer string).
  fundAmountValue String?
  fundAmountCurrency String?
  /// CCR-23: stellar | mock
  fundNetwork String?
  /// CCR-23: vault contract / mock vault id
  fundVaultId String?
  errorCode   String?
  errorMessage String?
  reversalOf  String?
  simulated   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([paymentId, position])
  /// Partial unique for deposit identity is in migration SQL (WHERE fundTxRef IS NOT NULL).
  @@index([fundTxRef])
  /// Lane B / F4: Solana (and other) release evidence must be unique across payments.
  /// Partial unique is in migration SQL (WHERE releaseTxRef IS NOT NULL).
}

model Batch {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  payments Payment[]

  @@index([organizationId])
}

model ClaimLink {
  paymentId String   @id
  payment   Payment  @relation(fields: [paymentId], references: [id])
  /// sha256 of the URL token; the raw token exists only in the link.
  tokenHash String   @unique
  /// sha256 hex of the vault claim secret (LockRequest.claimHashHex). Not secret (CCR-11).
  vaultClaimHashHex String?
  /// AES-256-GCM sealed claim secret (CCR-11). Never expose via API/events/logs.
  secretSealed      Bytes?
  secretSealedNonce Bytes?
  expiresAt DateTime
  status    String   @default("open") // open | accepted | expired
  createdAt DateTime @default(now())

  /// Lane B / F5: Endpoint.id accepted on this claim (Solana destination binding).
  acceptedEndpointId String?
  /// Lane B / F4: Solana Pay reference pubkey bound at accept; required in confirm tx.
  solanaPayReference String?
  /// Lane B / F4: first intent issuance time; confirm rejects older on-chain txs.
  solanaIntentAt DateTime?

  /// CCR-21 (ELFOGADÁSRA VÁR): passkey wallet bound to this claim after deploy SUCCESS.
  passkeyContractId String?
  /// Final successful deploy tx hash (hex). Sole durable deploy success ref for this claim.
  passkeyDeployTxHash String?
  /// Target C… bound BEFORE send (with pending hash). Must match body.contractId.
  passkeyDeployPendingContractId String?
  /// Persisted BEFORE rpc send. Hex hash of the assembled deploy tx.
  passkeyDeployPendingTxHash String?
  /// Sealed deploy recovery envelope (CCR-11 seal). Secret-bearing carrier XDR.
  passkeyDeployPendingSealed Bytes?
  passkeyDeployPendingSealedNonce Bytes?

  /// CCR-22: classic G… that received vault release (SEP-10 auth account for withdraw).
  recipientClassicAddress String?
  /// SEP-24 withdraw transaction id bound to this claim (unique across claims).
  anchorTxId String? @unique
  /// Sanitised hosted URL only (no query/token). Never store interactiveUrl/JWT.
  anchorUrlSanitised String?
  /// Amount (USDC major units) used when anchorTxId was started — blocks amount mismatch replay.
  anchorWithdrawAmount String?
  /// Atomic withdraw session reservation: null | starting | ready (before external SEP-24).
  anchorSessionStatus String?
  /// Our classic memo payment hash (build/sign before submit). Separate from SEP-24 stellar_transaction_id.
  anchorPaymentTxHash String?
  /// SEP-24 published stellar_transaction_id (anchor side). Never conflate with anchorPaymentTxHash.
  anchorStellarTransactionId String?
  /// CCR-22 /pay: pre-submit sealed signed envelope (CCR-11 seal). Never log.
  anchorPayPendingTxHash String?
  anchorPayPendingSealed Bytes?
  anchorPayPendingSealedNonce Bytes?
  anchorPayMinTime Int?
  anchorPayMaxTime Int?
  /// prepared | submitted | uncertain
  anchorPayStatus String?

  @@index([passkeyDeployPendingTxHash])
  @@index([passkeyDeployTxHash])
  @@index([anchorPayPendingTxHash])
}

/// CCR-21 (ELFOGADÁSRA VÁR): durable passkey prepare + submit reservation for M2.
/// Not accepted shared interface until integrator ACK. Secret-bearing blobs use CCR-11 seal key.
/// HTTP idempotency for deploy/submit uses IdempotencyRecord (payment.organizationId), not this table.
/// Release success is Leg.releaseTxRef only — no releaseTxHash here.
model PasskeyClaimPrepare {
  id                        String   @id
  paymentId                 String
  payment                   Payment  @relation(fields: [paymentId], references: [id])
  /// sha256 of the claim URL token (same as ClaimLink.tokenHash).
  tokenHash                 String
  contractId                String
  payoutId                  String
  networkPassphrase         String
  /// Sole ledger expiry for every auth entry (backend → sign → submit).
  signatureExpirationLedger Int
  /// open | reserved | submitted | expired | failed
  status                    String   @default("open")
  /// JSON string[]: sha256 hex of each unsigned rootInvocation XDR (order matches auth entries).
  authInvocationFingerprints Json
  /// JSON string[]: Soroban auth nonce per entry (decimal string).
  authNonces                Json
  /// JSON string[]: expected auth address per entry (C…).
  authAddresses             Json
  /// AES-256-GCM sealed unsigned auth entry XDRs (JSON string[]); secret-bearing.
  authEntriesSealed         Bytes
  authEntriesSealedNonce    Bytes
  /// Atomic submit reservation (open → reserved). Separate from HTTP IdempotencyRecord.
  reservedAt                DateTime?
  /// Persisted BEFORE rpc send. Hex hash of the assembled release tx.
  pendingTxHash             String?
  /// Sealed recovery payload (signed envelope XDR); secret-bearing.
  pendingTxSealed           Bytes?
  pendingTxSealedNonce      Bytes?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([paymentId, status])
  @@index([tokenHash])
  @@index([pendingTxHash])
}

model WebhookSubscription {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  url            String
  secret         String
  eventTypes     String[]
  createdAt      DateTime     @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id             String              @id
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id])
  eventId        String
  attempts       Int                 @default(0)
  lastStatus     String?
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?

  @@index([subscriptionId])
  @@index([eventId])
}

model Event {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String
  paymentId      String?
  payment        Payment?     @relation(fields: [paymentId], references: [id])
  /// Snapshot of the payment at the time of the event (§9).
  snapshot       Json
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([paymentId])
}

/// One row per state transition (§7: every transition writes an event and an audit row).
model AuditRow {
  id         String   @id
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id])
  entity     String // payment | leg
  entityId   String
  fromStatus String?
  toStatus   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([paymentId])
}

/// Idempotency-Key handling for every POST (§10).
model IdempotencyRecord {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  /// Hash of method, path and body: the same key with a different request is a 409.
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime     @default(now())

  @@unique([organizationId, key])
}

// TASK 06: customer authentication (Better Auth). Customer sessions are separate from server
// API keys: a session identifies a person, an API key identifies an organization's server.
// Passwords are stored only as scrypt hashes in AuthAccount.password.

model AuthUser {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    AuthSession[]
  accounts    AuthAccount[]
  memberships Membership[]
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  /// Opaque random token; the cookie carries it signed. Deleting the row revokes the session.
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Which organization a user acts for. One organization per user for the MVP (userId unique),
/// which also makes organization bootstrap race-safe: the unique key lets exactly one
/// concurrent bootstrap win and the others re-read.
model Membership {
  id             String       @id
  userId         String       @unique
  user           AuthUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           String       @default("owner") // owner | member
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
